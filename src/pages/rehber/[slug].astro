---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import CallButtons from '../../components/CallButtons.astro';
import Faq from '../../components/Faq.astro';
import { rehberler, type Rehber } from '../../data/rehber';
import { hizmetBySlug } from '../../data/hizmetler';

export function getStaticPaths() {
  return rehberler.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
const { r } = Astro.props as { r: Rehber };
const site = Astro.site!.toString().replace(/\/$/, '');
const h = hizmetBySlug(r.hizmet);
const url = `${site}/rehber/${r.slug}/`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: r.title,
    description: r.metaDescription,
    url,
    mainEntityOfPage: url,
    datePublished: r.published,
    dateModified: r.published,
    inLanguage: 'tr',
    image: `${site}/og.png`,
    author: { '@id': `${site}/#isletme` },
    publisher: { '@id': `${site}/#isletme` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: r.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
const tarih = new Date(r.published).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={r.metaTitle} description={r.metaDescription} breadcrumbs={[{ name: r.title, path: `/rehber/${r.slug}/` }]} schema={schema} ogType="article">
  <Crumbs items={[{ name: 'Rehber', path: '/#rehberler' }, { name: r.title }]} />
  <article>
    <section class="kap hero">
      <span class="ust-yazi">{r.minutes} dk okuma</span>
      <h1>{r.title}</h1>
      <p class="cevap"><strong>Kısa cevap:</strong> {r.answer}</p>
      <p class="tarih">Güncelleme: <time datetime={r.published}>{tarih}</time></p>
    </section>

    <section class="kap bolum" aria-labelledby="r-adim">
      <h2 id="r-adim">Adım adım</h2>
      <ol class="adimlar">{r.steps.map((s) => <li><h3>{s.t}</h3><p>{s.d}</p></li>)}</ol>
    </section>

    {r.sections.map((s, i) => (
      <section class="kap bolum" aria-labelledby={`r-b${i}`}>
        <h2 id={`r-b${i}`}>{s.h}</h2>
        {s.p && <div class="prose">{s.p.map((p) => <p>{p}</p>)}</div>}
        {s.table && (
          <div class="tablo-kap" tabindex="0" role="region" aria-label="Karşılaştırma tablosu"><table>
            <thead><tr>{s.table.head.map((c) => <th scope="col">{c}</th>)}</tr></thead>
            <tbody>{s.table.rows.map((row) => <tr>{row.map((c) => <td>{c}</td>)}</tr>)}</tbody>
          </table></div>
        )}
      </section>
    ))}

    <section class="kap bolum" aria-labelledby="r-ara">
      <div class="cagri">
        <h2 id="r-ara">Ne zaman aramalı?</h2>
        <p>{r.whenCall}</p>
        <CallButtons />
        <p><a href={`/${h.slug}/`}>{h.name} hizmetimiz hakkında →</a></p>
      </div>
    </section>

    <Faq items={r.faq} id="r-sss" />
  </article>
</Base>
