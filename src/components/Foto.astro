---
// Gerçek fotoğraf. src yoksa hiçbir şey basmaz; fotoğrafı olmayan bölümler sayfalarda gizlenir
// (yayında boş yer tutucu kutu görünmesin diye).
interface Props { title: string; note: string; src?: string; alt?: string; ratio?: string; pos?: string }
const { title, note, src, alt = '', ratio = '16/9', pos = 'center' } = Astro.props;
---
{src && <img class="foto-img" src={src} alt={alt || `${title}: ${note}`} loading="lazy" decoding="async" style={`aspect-ratio:${ratio};width:100%;object-fit:cover;object-position:${pos};border-radius:14px`} />}
