---
// Gerçek fotoğraf gelene kadar yer tutucu. src verilirse gerçek görsel basılır.
interface Props { title: string; note: string; src?: string; alt?: string; ratio?: string }
const { title, note, src, alt = '', ratio = '16/9' } = Astro.props;
---
{src
  ? <img src={src} alt={alt} loading="lazy" decoding="async" style={`aspect-ratio:${ratio};width:100%;object-fit:cover;border-radius:14px`} />
  : <div class="foto" style={`aspect-ratio:${ratio}`} role="img" aria-label={`${title} (fotoğraf yakında)`}><div><b>{title}</b>{note}</div></div>}
