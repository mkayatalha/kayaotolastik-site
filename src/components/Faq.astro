---
import type { Faq } from '../data/hizmetler';
interface Props { items: Faq[]; id: string; kicker?: string; title?: string }
const { items, id, kicker = 'Sık sorulanlar', title = 'Aklınızdaki sorular' } = Astro.props;
---
<section class="kap bolum" aria-labelledby={id}>
  <div>
    <p class="ust-yazi">{kicker}</p>
    <h2 id={id}>{title}</h2>
  </div>
  <div class="sss">
    {items.map((f, i) => (
      <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>
    ))}
  </div>
</section>
